set(APP_NAME Kodi)
set(APP_NAME_LC kodi)
set(APP_NAME_UC KODI)
set(APP_PACKAGE org.xbmc.kodi)
set(APP_VERSION_MAJOR 21)
set(APP_VERSION_MINOR 3)
set(APP_VERSION_CODE 21.3.0)
if(NOT KODI_PREFIX)
  set(KODI_PREFIX /opt/kodi)
endif()
if(NOT KODI_INCLUDE_DIR)
  set(KODI_INCLUDE_DIR /opt/kodi/include/kodi)
endif()
if(NOT KODI_LIB_DIR)
  set(KODI_LIB_DIR /opt/kodi/lib/kodi)
endif()
if(NOT KODI_DATA_DIR)
  set(KODI_DATA_DIR /opt/kodi/share/kodi)
endif()
set(APP_RENDER_SYSTEM gles)
list(APPEND CMAKE_MODULE_PATH /opt/kodi/lib/kodi /opt/kodi/share/kodi/cmake)

string(REPLACE ";" " " ARCH_DEFINES "-DTARGET_POSIX;-DTARGET_LINUX;-D_GNU_SOURCE;-DHAVE_LINUX_DMA_BUF=1;-DHAVE_MKOSTEMP=1;-DHAVE_GETMNTENT_R=1;-DHAVE_LINUX_MEMFD=1;-DHAVE_STATX=1")
add_definitions(${ARCH_DEFINES} -DBUILD_KODI_ADDON)

set(CORE_SYSTEM_NAME linux)
set(PLATFORM linux)
set(PLATFORM_TAG )
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

include(AddonHelpers)
